<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>LivrariaCommand</RootNamespace>
    <AssemblyName>LivrariaCommand</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivrariaCore\LivrariaCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\autores.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\livros.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
