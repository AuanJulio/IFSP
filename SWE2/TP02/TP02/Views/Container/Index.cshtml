@model IEnumerable<TP02.Models.Container>

@{
    ViewData["Title"] = "Lista de Containers";
}

<h2>Containers</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Novo Container</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Tamanho</th>
            <th>BL</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Numero</td>
                <td>@item.Tipo</td>
                <td>@item.Tamanho'</td>
                <td>@item.BL?.Numero</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>