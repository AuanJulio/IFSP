@model IEnumerable<TP02.Models.BL>

@{
    ViewData["Title"] = "Lista de BL";
}

<h2>BL (Bill of Lading)</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Novo BL</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Número</th>
            <th>Consignee</th>
            <th>Navio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Numero</td>
                <td>@item.Consignee</td>
                <td>@item.Navio</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>