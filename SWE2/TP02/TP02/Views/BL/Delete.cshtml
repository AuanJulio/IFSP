@model TP02.Models.BL

@{
    ViewData["Title"] = "Excluir BL";
}

<h2>Excluir BL</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h4>Tem certeza que deseja excluir este BL?</h4>
<dl class="row">
    <dt class="col-sm-2">Número</dt>
    <dd class="col-sm-10">@Model.Numero</dd>
    <dt class="col-sm-2">Consignee</dt>
    <dd class="col-sm-10">@Model.Consignee</dd>
    <dt class="col-sm-2">Navio</dt>
    <dd class="col-sm-10">@Model.Navio</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>