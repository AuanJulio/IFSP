@model IEnumerable<TP02.Models.BL>

@{
    ViewData["Title"] = "Relatório BL/Container";
}

<h2>Relatório — BL e seus Containers</h2>

@foreach (var bl in Model)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>BL @bl.Numero</strong> — Consignee: @bl.Consignee — Navio: @bl.Navio
        </div>
        <div class="card-body p-0">
            @if (bl.Containers.Any())
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th>Número Container</th><th>Tipo</th><th>Tamanho</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in bl.Containers)
                        {
                            <tr>
                                <td>@c.Numero</td>
                                <td>@c.Tipo</td>
                                <td>@c.Tamanho'</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted p-3 mb-0">Nenhum container associado.</p>
            }
        </div>
    </div>
}