<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TarefasApp.DetalhesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes da Tarefa">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Border
                BackgroundColor="{AppThemeBinding Light=White,
                                                  Dark=#2B2B2B}"
                Stroke="{AppThemeBinding Light=#E0E0E0,
                                         Dark=#444444}"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Padding="20" Spacing="12">

                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        Text="{Binding Titulo}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

                    <Label
                        FontSize="12"
                        Text="DESCRIÇÃO"
                        TextColor="{StaticResource Gray500}" />
                    <Label FontSize="16" Text="{Binding Descricao}" />

                    <Label
                        FontSize="12"
                        Text="DATA DE CRIAÇÃO"
                        TextColor="{StaticResource Gray500}" />
                    <Label FontSize="16" Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy}'}" />

                    <Label
                        FontSize="12"
                        Text="PRIORIDADE"
                        TextColor="{StaticResource Gray500}" />
                    <Border
                        Padding="14,4"
                        BackgroundColor="{Binding CorPrioridade}"
                        HorizontalOptions="Start"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14">
                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Prioridade}"
                            TextColor="White" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Clicked="OnEditarClicked"
                    Text="Editar" />
                <Button
                    Grid.Column="1"
                    BackgroundColor="#E53935"
                    Clicked="OnExcluirClicked"
                    Text="Excluir"
                    TextColor="White" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>