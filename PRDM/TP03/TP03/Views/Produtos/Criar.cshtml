@model Produto

@{
    ViewData["Title"] = "Novo produto";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Novo produto</h1>
    <p class="text-muted mb-0">Preencha os dados abaixo para cadastrar um produto.</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Criar" method="post">
            <partial name="_CamposProduto" model="Model" />

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Cadastrar produto</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}