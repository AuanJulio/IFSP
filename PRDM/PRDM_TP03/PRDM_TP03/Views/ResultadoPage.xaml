<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PRDM_TP03.ViewModels"
             xmlns:models="clr-namespace:PRDM_TP03.Models"
             x:Class="PRDM_TP03.Views.ResultadoPage"
             x:DataType="vm:ResultadoViewModel"
             Title="Resultado do Rastreamento">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          Padding="20"
          RowSpacing="12">

        <Border Grid.Row="0"
                Padding="16"
                Stroke="LightGray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Label Text="Código de rastreamento" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding PacoteAtual.Id}" FontSize="22" FontAttributes="Bold" />

                <Border BackgroundColor="{Binding CorStatus}"
                        StrokeThickness="0"
                        Padding="12,6"
                        HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 16">
                    <Label Text="{Binding PacoteAtual.Status}"
                           TextColor="White"
                           FontAttributes="Bold" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                Padding="16"
                Stroke="LightGray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="2">

                <Label Grid.Row="0" Grid.Column="0" Text="Data de envio" FontSize="12" TextColor="Gray" />
                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding PacoteAtual.DataEnvio, StringFormat='{0:dd/MM/yyyy}'}"
                       FontAttributes="Bold" />

                <Label Grid.Row="0" Grid.Column="1" Text="Previsão de entrega" FontSize="12" TextColor="Gray" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding PacoteAtual.DataPrevistaEntrega, StringFormat='{0:dd/MM/yyyy}'}"
                       FontAttributes="Bold" />

                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Localização atual" FontSize="12" TextColor="Gray" Margin="0,10,0,0" />
                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding PacoteAtual.LocalizacaoAtual}"
                       FontAttributes="Bold" />
            </Grid>
        </Border>

        <Label Grid.Row="2"
               Text="Histórico de eventos"
               FontSize="18"
               FontAttributes="Bold" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Historico}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EventoRastreamento">
                    <Border Padding="12"
                            Margin="0,4"
                            Stroke="LightGray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Descricao}" FontAttributes="Bold" />
                            <Label Text="{Binding Local}" />
                            <Label Text="{Binding DataHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4"
                Text="Nova consulta"
                Command="{Binding VoltarCommand}" />
    </Grid>
</ContentPage>